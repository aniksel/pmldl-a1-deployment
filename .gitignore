# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Airflow (local AIRFLOW_HOME = services/airflow) ----
services/airflow/logs/*
!services/airflow/logs/.gitkeep
services/airflow/*.db
services/airflow/*.db-shm
services/airflow/*.db-wal
services/airflow/*.cfg
services/airflow/*.pid
services/airflow/*.err
services/airflow/*.log
services/airflow/simple_auth_manager_passwords.json.generated
services/airflow/dags/__pycache__/

# ---- MLflow ----
mlflow.db
mlartifacts/

# ---- Data & models (regenerated by the pipeline) ----
# The raw dataset is committed on purpose: it is the pipeline's input,
# so a fresh clone can run the pipeline without network access.
!data/raw/housing.csv
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
.ipynb_checkpoints/
